#!/usr/bin/env bash
set -euo pipefail

STANDARDS_DIR="standards"
OUTPUT_FILE="ci/gitlab/verification-process/cheks_jobs.yml"

usage() {
    cat <<'EOF'
Usage:
  bin/creative_process/generate_checks_jobs [--standards-dir standards] [--output ci/gitlab/verification-process/cheks_jobs.yml]

Generates a GitLab CI jobs file from standards/**/.gitlab-ci.yml.

Options:
  -s, --standards-dir PATH   Directory with standards. Default: standards
  -o, --output PATH          Output file. Default: ci/gitlab/verification-process/cheks_jobs.yml
  -h, --help                 Show this help
EOF
}

fail() {
    printf 'ERROR: %s\n' "$*" >&2
    exit 1
}

parse_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
        -s|--standards-dir)
            [[ $# -ge 2 ]] || fail "$1 requires a value"
            STANDARDS_DIR="$2"
            shift 2
            ;;
        -o|--output)
            [[ $# -ge 2 ]] || fail "$1 requires a value"
            OUTPUT_FILE="$2"
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            fail "unknown argument: $1"
            ;;
        esac
    done
}

append_standard_ci() {
    local file="$1"
    local jobs_count

    jobs_count="$(yq -r 'keys | length' "$file")"
    [[ "$jobs_count" == "1" ]] || fail "$file must define exactly one top-level standard job, got $jobs_count"

    {
        printf '\n'
        printf '# Source: %s\n' "$file"
        awk 'NR == 1 && $0 == "---" { next } { print }' "$file"
    } >> "$OUTPUT_FILE"
}

main() {
    local found=0
    local output_dir

    parse_args "$@"

    command -v yq >/dev/null 2>&1 || fail "required command not found: yq"
    [[ -d "$STANDARDS_DIR" ]] || fail "standards directory not found: $STANDARDS_DIR"

    output_dir="$(dirname "$OUTPUT_FILE")"
    mkdir -p "$output_dir"

    {
        printf '%s\n' '---'
        printf '# Generated by bin/creative_process/generate_checks_jobs. Do not edit manually.\n'
        printf '# Each standards/**/.gitlab-ci.yml file should define one standard job.\n'
    } > "$OUTPUT_FILE"

    while IFS= read -r file; do
        found=1
        append_standard_ci "$file"
    done < <(find "$STANDARDS_DIR" -path '*/.gitlab-ci.yml' -type f | sort)

    if [[ "$found" -eq 0 ]]; then
        printf '# No standard jobs found.\n' >> "$OUTPUT_FILE"
    fi

    printf 'Generated %s\n' "$OUTPUT_FILE"
}

main "$@"
